---
import "../styles/header.css";
import Boton from "./Buttons.astro";
---

<header class="header_container" id="inicio">
    <div class="header_left_container">
        <div class="left_text_container">
            <!-- Título principal -->
            <h1 class="header_title reveal" style="--i: 0">
                Convertí tus <br />
                redes sociales <br class="title_br" />
                en una herramienta de crecimiento para tu <br class="title_br_mobile" />
                <span class="title_accent">marca.</span>
            </h1>

            <!-- Párrafo -->
            <p class="header_text reveal" style="--i: 1">
                Community Manager y Social Media con mirada de marketing. Cuido tu marca en redes como si fuera mía, sin perder tu esencia.
            </p>
        </div>

        <div class="left_buttons_container reveal" style="--i: 2">
            <Boton texto="VER MIS SERVICIOS" href="#servicios" variante="primaria" />
            <Boton texto="QUIERO TRABAJAR CON VOS" href="#como-trabajo" variante="secundaria" />
        </div>
    </div>

    <!-- Logo Animado a la derecha -->
    <div class="header_right_container reveal" style="--i: 3">
        <img
            src="/animations/logo_animado.svg"
            alt="Logo animado de Luzsaracommunity"
            width="400"
            height="400"
            fetchpriority="high"
        />
    </div>

    <!-- Indicador de scroll (mouse) -->
    <a class="mouse_button_container" href="#sobre-mi" aria-label="Bajar a la siguiente sección">
        <span class="mouse_body"><span class="mouse_wheel"></span></span>
        <span class="mouse_text">SCROLL</span>
    </a>
</header>