---
import "../styles/footer.css";

const year = new Date().getFullYear();

const whatsappSvg = `<path fill="currentColor" stroke="none" d="M12.03 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.49 1.34 5.01L2 22l5.12-1.34A9.96 9.96 0 0 0 12.03 22c5.52 0 10-4.48 10-10s-4.48-10-10-10Zm0 18.18c-1.5 0-2.97-.4-4.25-1.16l-.3-.18-3.04.8.81-2.96-.2-.31a8.15 8.15 0 0 1-1.26-4.37c0-4.51 3.67-8.18 8.18-8.18 4.51 0 8.18 3.67 8.18 8.18 0 4.51-3.61 8.18-8.12 8.18Zm4.49-6.12c-.25-.12-1.46-.72-1.68-.8-.23-.08-.39-.12-.56.12-.16.25-.64.8-.78.97-.14.16-.29.19-.54.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.71-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.83-.2-.48-.4-.41-.56-.42h-.47c-.16 0-.43.06-.66.31-.23.25-.86.84-.86 2.06s.88 2.39 1.01 2.55c.12.16 1.74 2.66 4.21 3.73.59.25 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.46-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.16-.47-.29Z"/>`;

const contactos = [
  {
    label: "Email",
    texto: "jazmin.isabella@luzsaracommunity.com",
    href: "mailto:jazmin.isabella@luzsaracommunity.com",
    svg: `<path d="M3 6.5A2.5 2.5 0 0 1 5.5 4h13A2.5 2.5 0 0 1 21 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5ZM3.5 7l8.5 6 8.5-6" />`,
  },
  {
    label: "WhatsApp",
    texto: "+54 9 11 3429-2032",
    href: "https://wa.me/5491134292032?text=Hola%20Jazm%C3%ADn!%20Quiero%20hacerte%20una%20consulta.",
    svg: whatsappSvg,
  },
  {
    label: "Ubicación",
    texto: "Buenos Aires, Argentina",
    href: null,
    svg: `<path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21ZM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" />`,
  },
];

const redes = [
  {
    nombre: "Instagram",
    href: "https://www.instagram.com/luzsaracommunity?utm_source=ig_web_button_share_sheet&dlrf=ZDNlZDc0MzIxNw==",
    icono:
      '<rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/>',
  },
  {
    nombre: "WhatsApp",
    href: "https://wa.me/5491134292032?text=Hola%20Jazm%C3%ADn!%20Me%20encantar%C3%ADa%20ver%20tu%20portafolio%20de%20trabajos.",
    icono: whatsappSvg,
  },
  {
    nombre: "TikTok",
    href: "https://www.tiktok.com/@luzsaracommunity",
    icono:
      '<path d="M14 3v11.2a3.2 3.2 0 1 1-3.2-3.2"/><path d="M14 3c.3 2.4 1.9 4 4.5 4.2"/>',
  },
];
---

<footer class="footer" id="contacto">
  <div class="footer__sea" aria-hidden="true">
    <svg class="footer__wave footer__wave--back" viewBox="0 0 2880 120" preserveAspectRatio="none">
      <path d="M0 60Q360 0 720 60T1440 60T2160 60T2880 60V120H0Z" />
    </svg>
    <svg class="footer__wave footer__wave--front" viewBox="0 0 1440 120" preserveAspectRatio="none">
      <path d="M0 70Q360 20 720 70T1440 70V120H0Z" />
    </svg>
  </div>

  <div class="footer__body">
    <span class="footer__bubble" aria-hidden="true"></span>
    <span class="footer__bubble" aria-hidden="true"></span>
    <span class="footer__bubble" aria-hidden="true"></span>
    <span class="footer__bubble" aria-hidden="true"></span>
    <span class="footer__bubble" aria-hidden="true"></span>
    <span class="footer__bubble" aria-hidden="true"></span>

    <div class="footer__inner">
      <div class="footer__brand">
        <a href="#inicio" class="footer__logo" aria-label="Ir al inicio">
          <img src="/logo.svg" alt="Luzsara Community" width="120" height="36" loading="lazy" decoding="async" />
        </a>
        <p class="footer__script">contacto</p>
        <h2 class="footer__title">¿Hablamos?</h2>
        <p class="footer__tagline">Estrategia y creatividad para marcas que buscan crecer.</p>
      </div>

      <ul class="footer__contact">
        {
          contactos.map(({ label, texto, href, svg }) => (
            <li>
              {href ? (
                <a class="footer__item" href={href} target={href.startsWith("http") ? "_blank" : undefined} rel={href.startsWith("http") ? "noopener noreferrer" : undefined}>
                  <span class="footer__item-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" set:html={svg} />
                  </span>
                  <span class="footer__item-text">
                    <span class="footer__item-label">{label}</span>
                    <span class="footer__item-value">{texto}</span>
                  </span>
                </a>
              ) : (
                <div class="footer__item">
                  <span class="footer__item-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" set:html={svg} />
                  </span>
                  <span class="footer__item-text">
                    <span class="footer__item-label">{label}</span>
                    <span class="footer__item-value">{texto}</span>
                  </span>
                </div>
              )}
            </li>
          ))
        }
      </ul>

      <div class="footer__social">
        <p class="footer__label">Seguime en redes</p>
        <ul class="footer__circles">
          {
            redes.map(({ nombre, href, icono }) => (
              <li>
                <a class="footer__circle" href={href} target="_blank" rel="noopener noreferrer" aria-label={nombre}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icono} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="footer__legal">© {year} Luzsara Community. Todos los derechos reservados.</p>
  </div>
</footer>

<script>
  let observer: IntersectionObserver | undefined;

  function initFooter() {
    const footer = document.getElementById("contacto");
    if (!footer || !("IntersectionObserver" in window)) return;

    observer?.disconnect();
    observer = new IntersectionObserver(
      ([entry]) => {
        footer.toggleAttribute("data-paused", !entry.isIntersecting);
      },
      { rootMargin: "200px 0px" }
    );
    observer.observe(footer);
  }

  initFooter();
  document.addEventListener("astro:page-load", initFooter);
</script>