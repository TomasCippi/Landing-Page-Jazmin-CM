---

<footer class="footer" id="contacto">
  <div class="footer__sea" aria-hidden="true">
    <svg class="footer__wave footer__wave--back" viewBox="0 0 2880 120" preserveAspectRatio="none">
      <path d="M0 60Q360 0 720 60T1440 60T2160 60T2880 60V120H0Z" />
    </svg>
    <svg class="footer__wave footer__wave--front" viewBox="0 0 1440 120" preserveAspectRatio="none">
      <path d="M0 70Q360 20 720 70T1440 70V120H0Z" />
    </svg>
  </div>

  <div class="footer__body">
    <span class="footer__bubble" aria-hidden="true"></span>
    <span class="footer__bubble" aria-hidden="true"></span>
    <span class="footer__bubble" aria-hidden="true"></span>
    <span class="footer__bubble" aria-hidden="true"></span>
    <span class="footer__bubble" aria-hidden="true"></span>
    <span class="footer__bubble" aria-hidden="true"></span>

    <div class="footer__inner">
      <div class="footer__brand">
        <a href="#inicio" class="footer__logo" aria-label="Ir al inicio">
          <img src="/logo.svg" alt="Luzsara Community" width="120" height="36" loading="lazy" decoding="async" />
        </a>
        <p class="footer__script">contacto</p>
        <h2 class="footer__title">¿Hablamos?</h2>
        <p class="footer__tagline">Estrategia y creatividad para marcas que buscan crecer.</p>
      </div>

      <ul class="footer__contact">
        {
          contactos.map(({ label, texto, href, icono }) => (
            <li>
              {href ? (
                <a class="footer__item" href={href}>
                  <span class="footer__item-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d={icono} />
                    </svg>
                  </span>
                  <span class="footer__item-text">
                    <span class="footer__item-label">{label}</span>
                    <span class="footer__item-value">{texto}</span>
                  </span>
                </a>
              ) : (
                <div class="footer__item">
                  <span class="footer__item-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d={icono} />
                    </svg>
                  </span>
                  <span class="footer__item-text">
                    <span class="footer__item-label">{label}</span>
                    <span class="footer__item-value">{texto}</span>
                  </span>
                </div>
              )}
            </li>
          ))
        }
      </ul>

      <div class="footer__social">
        <p class="footer__label">Seguime en redes</p>
        <ul class="footer__circles">
          {
            redes.map(({ nombre, href, icono }) => (
              <li>
                <a class="footer__circle" href={href} target="_blank" rel="noopener noreferrer" aria-label={nombre}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icono} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="footer__legal">© {year} Luzsara Community. Todos los derechos reservados.</p>
  </div>
</footer>

<script>
  // Las animaciones corren por defecto; solo se pausan cuando el footer
  // está fuera de pantalla. Si este script falla, las burbujas siguen andando.
  let observer: IntersectionObserver | undefined;

  function initFooter() {
    const footer = document.getElementById("contacto");
    if (!footer || !("IntersectionObserver" in window)) return;

    observer?.disconnect();
    observer = new IntersectionObserver(
      ([entry]) => {
        footer.toggleAttribute("data-paused", !entry.isIntersecting);
      },
      { rootMargin: "200px 0px" }
    );
    observer.observe(footer);
  }

  initFooter();
  document.addEventListener("astro:page-load", initFooter);
</script>