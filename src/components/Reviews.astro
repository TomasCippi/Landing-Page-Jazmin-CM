---
// Banner de números (#numeros). Estilos en src/styles/reviews.css
import "../styles/reviews.css";
---

<section class="stats_banner_section" id="numeros" data-pause-offscreen>
    <!-- Fondo fijo: queda quieto al scrollear y el banner es la "ventana" -->
    <div class="ocean_bg_fixed" aria-hidden="true">
        <svg class="ocean_svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" fill="none">
            <path class="wave_line wave_1" d="M-100,260 C240,200 480,320 720,260 C960,200 1200,320 1540,250 L1540,900 L-100,900 Z" />
            <path class="wave_line wave_2" d="M-100,470 C300,400 520,540 800,470 C1060,410 1260,520 1540,460 L1540,900 L-100,900 Z" />
            <path class="wave_line wave_3" d="M-100,680 C260,620 520,740 760,680 C1040,620 1240,720 1540,670 L1540,900 L-100,900 Z" />
        </svg>
    </div>

    <!-- Las posiciones (izquierda / derecha) se definen en el CSS con grid-template-areas -->
    <div class="reviews_content_wrapper">
        <!-- Texto + botón (va a la derecha en desktop) -->
        <div class="stats_intro">
            <span class="stats_eyebrow stats_reveal" style="--i: 3">EN NÚMEROS</span>

            <h2 class="stats_title stats_reveal" style="--i: 4">
                Crecer con intención <em>se nota</em>
            </h2>

            <p class="stats_description stats_reveal" style="--i: 5">
                Cada marca tiene su historia. Estos son algunos de los números del camino recorrido junto a mis clientes.
            </p>

            <div class="stats_action stats_reveal" style="--i: 6">
                <a class="stats_cta" href="#resenas">
                    <span class="stats_cta_text">VER RESEÑAS DE CLIENTES</span>
                    <span class="stats_cta_arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 5v14M6 13l6 6 6-6" />
                        </svg>
                    </span>
                </a>
            </div>
        </div>

        <!-- Los tres números (van a la izquierda en desktop) -->
        <ul class="stats_grid" role="list">
            <li class="stat_item stats_reveal" style="--i: 0">
                <div class="stat_card">
                    <span class="stat_icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 7v5l3 2" />
                        </svg>
                    </span>
                    <span class="stat_text">
                        <span class="stat_number">+<span class="counter" data-target="2">0</span></span>
                        <span class="stat_label">años de experiencia</span>
                    </span>
                </div>
            </li>

            <li class="stat_item stats_reveal" style="--i: 1">
                <div class="stat_card">
                    <span class="stat_icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="8" r="3.2" />
                            <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" />
                            <path d="M16 5.2a3.2 3.2 0 0 1 0 5.6M18 14.3c1.8.8 3 2.6 3 4.7" />
                        </svg>
                    </span>
                    <span class="stat_text">
                        <span class="stat_number">+<span class="counter" data-target="10">0</span></span>
                        <span class="stat_label">marcas acompañadas</span>
                    </span>
                </div>
            </li>

            <!-- Dato de ejemplo: cambiar data-target por el número real -->
            <li class="stat_item stats_reveal" style="--i: 2">
                <div class="stat_card">
                    <span class="stat_icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="16" rx="3" />
                            <circle cx="9" cy="10" r="1.8" />
                            <path d="M21 16l-5-5-8 9" />
                        </svg>
                    </span>
                    <span class="stat_text">
                        <span class="stat_number">+<span class="counter" data-target="150">0</span></span>
                        <span class="stat_label">contenidos creados</span>
                    </span>
                </div>
            </li>
        </ul>
    </div>
</section>

<script>
    /* ======================================================================
       BANNER DE NÚMEROS: entrada + contadores
       Cuando el banner entra en pantalla recibe la clase is_visible
       (el CSS hace la animación de entrada) y los números cuentan desde
       0 hasta su data-target. Se ejecuta una sola vez.
       ====================================================================== */

    const section = document.getElementById("numeros");
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Cuenta de 0 hasta el número final
    function animateCounter(counter) {
        const target = Number(counter.dataset.target || 0);

        // Si el usuario pidió menos movimiento, muestra el número final directo
        if (reduceMotion) {
            counter.textContent = target;
            return;
        }

        const duration = 1400;
        const start = performance.now();

        function tick(now) {
            const progress = Math.min((now - start) / duration, 1);
            // Frena suave al final (ease-out exponencial)
            const eased = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);

            counter.textContent = Math.round(eased * target);
            if (progress < 1) requestAnimationFrame(tick);
        }

        requestAnimationFrame(tick);
    }

    // Muestra el banner y arranca los contadores
    function reveal() {
        section.classList.add("is_visible");
        section.querySelectorAll(".counter").forEach(animateCounter);
    }

    if (section) {
        if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    if (!entries[0].isIntersecting) return;
                    reveal();
                    observer.disconnect(); // solo la primera vez
                },
                { threshold: 0.2 }
            );

            observer.observe(section);
        } else {
            // Navegadores muy viejos: mostrar todo de una
            reveal();
        }
    }
</script>