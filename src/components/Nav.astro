---
import '../styles/nav.css';
import Boton from './Buttons.astro';
---

<div class="nav_wrapper">
  <nav class="nav_container" aria-label="Navegación principal">
    <a href="#inicio" class="nav_logo" aria-label="Ir al inicio">
      <img 
        src="/logo.svg" 
        alt="Luzsara Community Logo" 
        class="nav_logo_img"
        width="120"
        height="36"
      />
    </a>

    <ul class="nav_links_container" id="nav-menu">
      <div class="nav_water_drop" id="water-drop"></div>
      <li><a href="#inicio" class="nav_link active">Inicio</a></li>
      <li><a href="#sobre-mi" class="nav_link">Sobre Mí</a></li>
      <li><a href="#servicios" class="nav_link">Mis servicios</a></li>
      <li><a href="#como-trabajo" class="nav_link">Cómo trabajo</a></li>
      <li><a href="#resenas" class="nav_link">Reseñas</a></li>
      <li><a href="#preguntas-frecuentes" class="nav_link">Preguntas frecuentes</a></li>
    </ul>

    <div class="nav_action">
      <Boton texto="Hablemos" href="https://wa.me/5491134292032?text=Hola%2C%20Jazm%C3%ADn.%20Me%20gustar%C3%ADa%20contactarme%20con%20vos%20para%20conversar%20sobre%20una%20posible%20colaboraci%C3%B3n." variante="primaria" />
    </div>

    <button class="nav_hamburger" id="hamburger-btn" aria-label="Abrir menú" aria-expanded="false">
      <span class="hamburger_line"></span>
      <span class="hamburger_line"></span>
      <span class="hamburger_line"></span>
    </button>
  </nav>

  <div class="nav_mobile_menu" id="mobile-menu" aria-hidden="true">
    <ul class="mobile_links_list">
      <li><a href="#inicio" class="mobile_link">Inicio</a></li>
      <li><a href="#sobre-mi" class="mobile_link">Sobre Mí</a></li>
      <li><a href="#servicios" class="mobile_link">Mis servicios</a></li>
      <li><a href="#como-trabajo" class="mobile_link">Cómo trabajo</a></li>
      <li><a href="#resenas" class="mobile_link">Reseñas</a></li>
      <li><a href="#preguntas-frecuentes" class="mobile_link">Preguntas frecuentes</a></li>
    </ul>
    <div class="mobile_action">
      <Boton texto="Hablemos por WhatsApp" href="#contacto" variante="primaria" />
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navMenu = document.getElementById('nav-menu');
    const drop = document.getElementById('water-drop');
    const links = document.querySelectorAll<HTMLAnchorElement>('.nav_link');
    const hamburger = document.getElementById('hamburger-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('.mobile_link');

    if (!navMenu || !drop || links.length === 0) return;

    function updateDropPosition(element: HTMLElement) {
      const parentRect = navMenu.getBoundingClientRect();
      const elemRect = element.getBoundingClientRect();

      const left = elemRect.left - parentRect.left;
      const width = elemRect.width;

      drop.style.left = `${left}px`;
      drop.style.width = `${width}px`;
      drop.style.opacity = '1';

      drop.classList.add('moving');
      setTimeout(() => drop.classList.remove('moving'), 350);
    }

    function initActive() {
      const activeLink = document.querySelector<HTMLAnchorElement>('.nav_link.active');
      if (activeLink && window.innerWidth > 860) {
        updateDropPosition(activeLink);
      }
    }

    initActive();
    window.addEventListener('resize', initActive);

    links.forEach(link => {
      link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('href');
        if (targetId && targetId.startsWith('#')) {
          const targetSection = document.querySelector(targetId);
          if (targetSection) {
            e.preventDefault();
            targetSection.scrollIntoView({ behavior: 'smooth' });
          }
        }

        links.forEach(l => l.classList.remove('active'));
        link.classList.add('active');
        updateDropPosition(link);
      });
    });

    if (hamburger && mobileMenu) {
      hamburger.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.toggle('is_open');
        hamburger.classList.toggle('is_active');
        hamburger.setAttribute('aria-expanded', String(isOpen));
        mobileMenu.setAttribute('aria-hidden', String(!isOpen));
      });

      mobileLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          const targetId = link.getAttribute('href');
          if (targetId && targetId.startsWith('#')) {
            const targetSection = document.querySelector(targetId);
            if (targetSection) {
              e.preventDefault();
              targetSection.scrollIntoView({ behavior: 'smooth' });
            }
          }
          mobileMenu.classList.remove('is_open');
          hamburger.classList.remove('is_active');
          hamburger.setAttribute('aria-expanded', 'false');
          mobileMenu.setAttribute('aria-hidden', 'true');
        });
      });
    }

    const sections = document.querySelectorAll('section[id], header[id]');
    const observerOptions = {
      root: null,
      rootMargin: '-30% 0px -50% 0px',
      threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          links.forEach(link => {
            if (link.getAttribute('href') === `#${id}`) {
              links.forEach(l => l.classList.remove('active'));
              link.classList.add('active');
              if (window.innerWidth > 860) {
                updateDropPosition(link);
              }
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach(section => observer.observe(section));
  });
</script>