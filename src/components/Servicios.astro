---
import "../styles/servicios.css";
import Boton from "./Buttons.astro";

const gestionRedes = [
    {
        id: "cm",
        numero: "01",
        titulo: "Community Manager",
        frase: "Tu marca presente todos los días, con tu esencia intacta.",
        icono: `<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>`,
        pregunta: "¿Por qué un Community Manager?",
        explicacion:
            "Mensajes que quedan sin contestar, una cuenta que pasa semanas sin publicar, comentarios que nadie atiende. Cada uno de esos detalles es un cliente que se va con la competencia. Un Community Manager mantiene tu marca activa y cercana, para que cada persona que te escribe se sienta atendida.",
        idealPara: [
            "Empresas y marcas",
            "Locales y comercios",
            "Profesionales y emprendimientos",
        ],
    },
    {
        id: "sm",
        numero: "02",
        titulo: "Social Media",
        frase: "Un plan detrás de cada publicación, para que tu marca avance.",
        icono: `<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>`,
        pregunta: "¿Por qué Social Media?",
        explicacion:
            "Subir contenido cuando hay tiempo, copiar lo que hacen otros o publicar sin saber qué funciona hace que tus redes no crezcan y no traigan ventas. Una Social Media le da dirección a todo: define qué publicar, cuándo y para qué, para que cada contenido acerque a tu marca a sus objetivos.",
        idealPara: [
            "Empresas que quieren posicionarse",
            "Pymes y locales",
            "Emprendimientos que recién arrancan",
        ],
    },
    {
        id: "ads",
        numero: "03",
        titulo: "Meta Ads",
        frase: "Tu inversión en publicidad, puesta donde están tus clientes.",
        icono: `<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>`,
        pregunta: "¿Por qué Meta Ads?",
        explicacion:
            "Tocar 'promocionar publicación' sin segmentar, invertir sin medir o mostrar anuncios a cualquiera hace que la plata se vaya sin resultados. Con Meta Ads bien gestionado, tus anuncios llegan a las personas indicadas y cada peso invertido trabaja para traerte clientes.",
        idealPara: [
            "Empresas y marcas que quieren vender más",
            "Locales que buscan clientes de su zona",
            "Emprendimientos con un lanzamiento",
        ],
    },
];

const proyectosPuntuales = [
    {
        id: "branding",
        numero: "04",
        titulo: "Branding",
        subtitulo: "Identidad de marca",
        frase: "Tu marca, con una identidad que se reconoce a primera vista.",
        icono: `<path d="M12 2L14.8 9.2L22 12L14.8 14.8L12 22L9.2 14.8L2 12L9.2 9.2L12 2Z"/>`,
        pregunta: "¿Por qué Branding?",
        explicacion:
            "Un logo hecho a las apuradas, colores que cambian en cada publicación, una marca que no transmite lo que es. Así cuesta que te recuerden y que confíen en vos. Con un branding pensado desde cero, tu marca tiene una identidad clara y coherente que se reconoce en cualquier lugar.",
        extraTitulo: "Qué incluye",
        extraTexto:
            "Logo · variantes del logo · paleta de colores · tipografías. De regalo: diseño de tarjetas para tu local (o la pieza que tu marca necesite).",
        idealPara: [
            "Empresas que quieren renovar su imagen",
            "Locales y pymes",
            "Emprendimientos que recién nacen",
        ],
    },
    {
        id: "disenos",
        numero: "05",
        titulo: "Diseños a pedido",
        subtitulo: "Flyers, videos, tarjetas, etiquetas y más",
        frase: "Piezas únicas para cada ocasión, listas cuando las necesitás.",
        icono: `<path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/>`,
        pregunta: "¿Qué podés pedir?",
        explicacion:
            "Para locales y negocios: tarjetas personales o de agradecimiento, flyers, menús, listas de precios, etiquetas, stickers, gift cards y catálogos. Para redes: edición de videos y reels. Para eventos: invitaciones de cumpleaños, 15, casamientos y fechas especiales.",
        idealPara: [
            "Empresas y marcas",
            "Locales y emprendimientos",
            "Cumpleaños y eventos",
        ],
    },
];
---

<section class="services_section" id="servicios" data-nav-theme="light">
    <div class="services_container">
        <header class="services_header" data-srv-title>
            <span class="services_dash" aria-hidden="true"></span>
            <h2 class="services_main_heading">
                <span class="services_title_mask">
                    <span class="services_title_big">SERVICIOS</span>
                </span>
                <span class="services_title_accent">
                    <span class="services_title_script">en qué te ayudo</span>
                </span>
            </h2>
        </header>
        <div class="services_group">
            <div class="group_header" data-srv-reveal>
                <h3 class="group_title">GESTIÓN DE REDES</h3>
                <span class="group_line" aria-hidden="true"></span>
            </div>

            <div class="cards_grid cards_grid--three">
                {
                    gestionRedes.map((item, idx) => (
                        <article
                            class="service_card service_card--primary"
                            style={`--delay: ${idx * 110}ms`}
                            data-service-card
                            data-srv-reveal
                        >
                            <div class="card_inner">
                                <!-- FRENTE -->
                                <div class="card_face card_front" data-face-front>
                                    <div class="card_top">
                                        <span class="card_num">{item.numero}</span>
                                        <span class="card_icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={item.icono} />
                                        </span>
                                    </div>

                                    <div class="card_body">
                                        <h4 class="card_title">{item.titulo}</h4>
                                        <p class="card_phrase">{item.frase}</p>
                                    </div>

                                    <button
                                        type="button"
                                        class="card_flip_btn"
                                        data-flip-trigger
                                        aria-expanded="false"
                                    >
                                        <span>Quiero saber más</span>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
                                        </svg>
                                    </button>
                                </div>

                                <!-- DORSO (Toda la info entra sin overflow) -->
                                <div class="card_face card_back" data-face-back aria-hidden="true" inert>
                                    <div class="card_back_top">
                                        <span class="card_back_script">{item.titulo}</span>
                                        <button
                                            type="button"
                                            class="card_close_btn"
                                            data-flip-close
                                            aria-label={`Volver al frente de ${item.titulo}`}
                                        >
                                            ← Volver
                                        </button>
                                    </div>

                                    <h5 class="card_back_title">{item.pregunta}</h5>
                                    <p class="card_back_desc">{item.explicacion}</p>

                                    <div class="card_ideal">
                                        <span class="card_ideal_label">Ideal para</span>
                                        <ul class="card_ideal_pills" role="list">
                                            {item.idealPara.map((pill) => (
                                                <li class="ideal_pill">{pill}</li>
                                            ))}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>

        <div class="services_group">
            <div class="group_header" data-srv-reveal>
                <h3 class="group_title">PROYECTOS PUNTUALES</h3>
                <span class="group_line" aria-hidden="true"></span>
            </div>

            <div class="cards_grid cards_grid--two">
                {
                    proyectosPuntuales.map((item, idx) => (
                        <article
                            class="service_card service_card--secondary"
                            style={`--delay: ${idx * 120}ms`}
                            data-service-card
                            data-srv-reveal
                        >
                            <div class="card_inner">
                                <!-- FRENTE -->
                                <div class="card_face card_front" data-face-front>
                                    <div class="card_top">
                                        <span class="card_num">{item.numero}</span>
                                        <span class="card_icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={item.icono} />
                                        </span>
                                    </div>

                                    <div class="card_body">
                                        <h4 class="card_title">{item.titulo}</h4>
                                        {item.subtitulo && (
                                            <span class="card_subtitle">{item.subtitulo}</span>
                                        )}
                                        <p class="card_phrase">{item.frase}</p>
                                    </div>

                                    <button
                                        type="button"
                                        class="card_flip_btn"
                                        data-flip-trigger
                                        aria-expanded="false"
                                    >
                                        <span>Quiero saber más</span>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
                                        </svg>
                                    </button>
                                </div>

                                <!-- DORSO -->
                                <div class="card_face card_back" data-face-back aria-hidden="true" inert>
                                    <div class="card_back_top">
                                        <span class="card_back_script">{item.titulo}</span>
                                        <button
                                            type="button"
                                            class="card_close_btn"
                                            data-flip-close
                                            aria-label={`Volver al frente de ${item.titulo}`}
                                        >
                                            ← Volver
                                        </button>
                                    </div>

                                    <h5 class="card_back_title">{item.pregunta}</h5>
                                    <p class="card_back_desc">{item.explicacion}</p>

                                    {item.extraTexto && (
                                        <div class="card_extra_box">
                                            <strong>{item.extraTitulo}:</strong> {item.extraTexto}
                                        </div>
                                    )}

                                    <div class="card_ideal">
                                        <span class="card_ideal_label">Ideal para</span>
                                        <ul class="card_ideal_pills" role="list">
                                            {item.idealPara.map((pill) => (
                                                <li class="ideal_pill">{pill}</li>
                                            ))}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>

            <p class="services_note" data-srv-reveal>
                ¿Te gustó cómo trabajo? Podés sumarte a una estrategia de gestión de redes cuando quieras.
            </p>
        </div>

        <div class="quote_banner" data-srv-reveal>
            <div class="quote_banner_text">
                <h3 class="quote_title">
                    Cada marca es distinta, <span>tu estrategia también</span>
                </h3>
                <p class="quote_desc">
                    Armo propuestas personalizadas según lo que hoy necesita tu negocio para crecer en redes.
                </p>
            </div>
            <div class="quote_banner_action">
                <Boton
                    texto="VER OPCIONES Y COTIZAR"
                    href="https://wa.me/5491134292032?text=Hola%20Jazm%C3%ADn!%20Quiero%20asesorarme%20y%20cotizar%20para%20mi%20marca."
                    variante="primaria"
                />
            </div>
        </div>
    </div>
</section>

<script>
    const section = document.getElementById("servicios");

    if (section) {
        const cards = section.querySelectorAll<HTMLElement>("[data-service-card]");

        const setFlipState = (card: HTMLElement, flipped: boolean) => {
            const front = card.querySelector<HTMLElement>("[data-face-front]");
            const back = card.querySelector<HTMLElement>("[data-face-back]");
            const openBtn = card.querySelector<HTMLButtonElement>("[data-flip-trigger]");
            const closeBtn = card.querySelector<HTMLButtonElement>("[data-flip-close]");

            card.classList.toggle("is_flipped", flipped);
            openBtn?.setAttribute("aria-expanded", String(flipped));

            if (flipped) {
                front?.setAttribute("aria-hidden", "true");
                front?.setAttribute("inert", "");
                back?.removeAttribute("aria-hidden");
                back?.removeAttribute("inert");
                closeBtn?.focus({ preventScroll: true });
            } else {
                back?.setAttribute("aria-hidden", "true");
                back?.setAttribute("inert", "");
                front?.removeAttribute("aria-hidden");
                front?.removeAttribute("inert");
            }
        };

        cards.forEach((card) => {
            const openBtn = card.querySelector<HTMLElement>("[data-flip-trigger]");
            const closeBtn = card.querySelector<HTMLElement>("[data-flip-close]");

            openBtn?.addEventListener("click", (e) => {
                e.stopPropagation();
                cards.forEach((c) => {
                    if (c !== card && c.classList.contains("is_flipped")) {
                        setFlipState(c, false);
                    }
                });
                setFlipState(card, true);
            });

            closeBtn?.addEventListener("click", (e) => {
                e.stopPropagation();
                setFlipState(card, false);
                openBtn?.focus({ preventScroll: true });
            });
        });

        // Cerrar con Escape
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                cards.forEach((c) => {
                    if (c.classList.contains("is_flipped")) setFlipState(c, false);
                });
            }
        });

        // Animación al scrollear (IntersectionObserver de alto rendimiento)
        const revealObserver = new IntersectionObserver(
            (entries, obs) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is_inview");
                        obs.unobserve(entry.target); // Deja de observar una vez animado para ahorrar CPU
                    }
                }
            },
            { threshold: 0.18, rootMargin: "0px 0px -6% 0px" }
        );

        const titleEl = section.querySelector("[data-srv-title]");
        if (titleEl) revealObserver.observe(titleEl);

        section.querySelectorAll("[data-srv-reveal]").forEach((el) => {
            revealObserver.observe(el);
        });
    }
</script>